# Copy this file to backend/.env and enable ONE provider block below.
# backend/.env is git-ignored; never put a real key in this example file.
# With no key configured, the app runs in rule-based offline mode.
# The backend reads .env only at startup: restart after editing.

# --- Option 1: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option 2: OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4.1-mini

# --- Option 3: OpenAI-compatible services (via OPENAI_BASE_URL) ---
# The model must support tool/function calling.
# Google Gemini:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
#
# Local Ollama (use a tool-calling model, e.g. qwen2.5):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# --- Option 4: DeepSeek ---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat          # or deepseek-reasoner (thinking mode)
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # optional

# Force offline mode even when keys are present:
# LLM_PROVIDER=offline
